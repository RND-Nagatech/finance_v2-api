PORT=5103
MONGO_URI=mongodb://localhost:27017/finance_v2
JWT_SECRET=change_this_to_a_strong_secret
DELETE_VALIDATED_SECRET_CODE=change_this_delete_secret_code
CORS_ORIGIN=http://localhost:5174

# DOKU Checkout (gunakan sandbox sampai proses testing selesai)
DOKU_ENVIRONMENT=sandbox
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
DOKU_PAYMENT_DUE_MINUTES=60
DOKU_REQUEST_TIMEOUT_MS=15000
DOKU_STATUS_TIMEOUT_MS=8000
# Base URL API publik untuk menerima redirect hasil pembayaran DOKU.
# URL final: ${CALLBACK_DOKU}/tt-vps/doku/result?token=...
CALLBACK_DOKU=https://finance.nagatech.id/api
# Opsional: override base URL DOKU, tanpa path /checkout/v1/payment
DOKU_BASE_URL=https://api-sandbox.doku.com
